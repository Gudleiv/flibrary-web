# Скопируйте в .env и поправьте пути.

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# Коллекция FLibrary — только чтение. Для разработки: pnpm fixtures
COLLECTION_DB=../../data/collection.db

# Наша БД: пользователи, сессии, пользовательские данные, поисковые индексы
APP_DB=../../data/app.db

# Дисковый кэш обложек
CACHE_DIR=../../data/cache

# Внутренний C++-сервер FLibrary (`opds`): обложки, файлы книг, конвертеры.
# В проде слушает только localhost и снаружи недоступен.
CONTENT_SERVICE_URL=http://127.0.0.1:12791

# Сколько запросов к нему держать в полёте. Больше числа ядер машины, где он крутится,
# ставить бессмысленно: его обработчики живут в пуле потоков такого размера, а лишнее
# просто стоит в очереди без ответа. См. комментарий в src/content/opds.ts.
CONTENT_SERVICE_CONCURRENCY=4

# Обязателен в проде, минимум 32 символа: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=30
COOKIE_NAME=flw_session
COOKIE_SECURE=false

# «Дополнительная папка» коллекции — та же, что в настройках FLibrary. Из неё читаются
# отзывы читателей (подкаталог reviews/, архивы 7z). Пусто — отзывов нет, раздел в
# карточке книги не показывается. Требует 7-Zip в системе.
ADDITIONAL_DIR=

# Скрывать книги, помеченные в коллекции удалёнными
HIDE_DELETED=true

# Кэш счётчиков фасетов в app.db, секунды. 0 — считать каждый раз заново
QUERY_CACHE_TTL_SECONDS=300
