# Скопируйте в `.env` рядом с docker-compose.yml и поправьте.
# В файле секреты — chmod 600 .env

# Домен: Caddy сам получит сертификат Let's Encrypt. Для локальной проверки — localhost.
# Если TLS терминирует внешний прокси, поставьте `:80` — тогда Caddy отдаёт голый HTTP
# на любом Host и за сертификатом не идёт.
SITE_ADDRESS=library.example.com

# Секрет подписи сессий, минимум 32 символа: openssl rand -hex 32
SESSION_SECRET=

# Кука сессии с флагом Secure. Ставить false, только если сервис открыт по HTTP (например,
# по LAN-адресу без домена): иначе браузер молча выбросит куку и вход не сработает.
COOKIE_SECURE=true

# --- Каталоги на хосте ------------------------------------------------------------------
# Все четыре — на дисках этой же машины (почему не сетевые — docs/decisions.md, решение 12).
# Библиотека монтируется read-only, наши данные — на запись.

# Каталог с архивами книг.
LIBRARY_PATH=/srv/library

# Каталог с collection.db. Лежит рядом с архивами — тот же путь, что и выше; лежит на
# быстром локальном диске, пока архивы на большом медленном, — свой.
COLLECTION_PATH=/srv/library

# Имя файла базы внутри COLLECTION_PATH.
COLLECTION_FILE=collection.db

# app.db: пользователи, сессии, поисковый индекс. Единственное, что стоит бэкапить.
# Каталоги создаются сами; относительные пути — от каталога с docker-compose.yml.
APP_PATH=./data/app

# Кэш обложек: восстанавливается сам, бэкапить не нужно.
CACHE_PATH=./data/cache

# --- Коллекция --------------------------------------------------------------------------
# Как коллекция называется в интерфейсе C++-сервера. Ни на что больше не влияет.
COLLECTION_NAME=collection

# Каталог с «дополнительными» файлами FLibrary: вынесенные из fb2 картинки (covers/,
# images/), как у flibusta, и отзывы читателей (reviews/, архивы 7z). Путь внутри
# контейнера, где LIBRARY_PATH — это /library. Пусто, если ни того, ни другого нет.
ADDITIONAL_DIR=

# --- Прочее ---------------------------------------------------------------------------
# Порты на хосте. HTTPS_PORT нужен, только когда 443 уже занят внешним прокси: Caddy при
# `SITE_ADDRESS=:80` на нём всё равно не слушает, но публикует.
HTTP_PORT=80
HTTPS_PORT=443

# Версия релиза FLibrary, из которой берётся C++-сервер (см. deploy/opds.Dockerfile).
FLIBRARY_VERSION=2.6.6
