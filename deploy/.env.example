# Скопируйте в `.env` рядом с docker-compose.yml и поправьте.
# В файле пароли — chmod 600 .env

# Домен: Caddy сам получит сертификат Let's Encrypt. Для локальной проверки — localhost.
SITE_ADDRESS=library.example.com

# Секрет подписи сессий, минимум 32 символа: openssl rand -hex 32
SESSION_SECRET=

# --- Библиотека -------------------------------------------------------------------------
# Каталог на хосте, в котором лежат collection.db и подкаталог с архивами книг.
# При деплое с SMB-шарой (docker-compose.smb.yml) не используется.
LIBRARY_PATH=/srv/library

# Имена внутри LIBRARY_PATH / внутри шары.
COLLECTION_FILE=collection.db
ARCHIVES_SUBDIR=archives

# Как коллекция называется в интерфейсе C++-сервера. Ни на что больше не влияет.
COLLECTION_NAME=collection

# Версия релиза FLibrary, из которой берётся C++-сервер (см. deploy/opds.Dockerfile).
FLIBRARY_VERSION=2.6.6

# --- SMB-шара (только для docker-compose.smb.yml) ----------------------------------------
SMB_HOST=nas.local
SMB_SHARE=library
# Подкаталог внутри шары, если библиотека лежит не в её корне: /books/flibrary
SMB_PATH=
SMB_USER=
SMB_PASSWORD=
SMB_VERS=3.1.1
